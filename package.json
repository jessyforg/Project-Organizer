{
  "name": "projectforge",
  "productName": "ProjectForge",
  "version": "0.3.0",
  "description": "Free, local-first Windows desktop project organizer",
  "private": true,
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder --win --x64",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers": false,
    "electron-winstaller": false,
    "esbuild": false
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "lucide-react": "1.51.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "unified": "11.0.5",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
